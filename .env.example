# Server Port (Render automatically sets this in production)
PORT=8000

# Environment Mode (production / development)
NODE_ENV=production

# PostgreSQL Database Connection String
# On Render: Link your PostgreSQL instance or Render provides DATABASE_URL automatically.
# Local example: postgresql://postgres:postgres@localhost:5432/confessions
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional individual connection parameters (used if DATABASE_URL is not set):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=confessions
# PGUSER=postgres
# PGPASSWORD=yourpassword

# SSL Mode: Set to true if your database requires SSL (recommended for cloud PostgreSQL like Render)
# Set to false for local testing without SSL.
DB_SSL=false
